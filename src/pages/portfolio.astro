---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { title: 'WooCommerce Shop', desc: 'Custom WooCommerce store with PAYUNi payment gateway integration, ACF custom fields, and Elementor layouts.', tags: ['PHP', 'WooCommerce', 'PAYUNi', 'ACF'], category: 'wordpress', url: '#' },
  { title: 'Astro Portfolio Site', desc: 'Lightning-fast portfolio site built with Astro 4 + static output, deployed on Cloudflare Pages with auto CI/CD.', tags: ['Astro', 'Cloudflare', 'CSS'], category: 'astro', url: '#' },
  { title: 'WordPress Plugin', desc: 'Custom WordPress plugin for form management, data export, and automated email notifications.', tags: ['PHP', 'WordPress', 'MySQL'], category: 'wordpress', url: '#' },
  { title: 'FlyWP Server Setup', desc: 'Production WordPress server stack on Ubuntu with FlyWP, Nginx, Docker, and Cloudflare proxy.', tags: ['FlyWP', 'Nginx', 'Docker', 'Cloudflare'], category: 'devops', url: '#' },
  { title: 'ECPay Integration', desc: 'Full ECPay checkout flow with webhook verification, order status sync, and admin dashboard.', tags: ['PHP', 'ECPay', 'WooCommerce'], category: 'wordpress', url: '#' },
  { title: 'Headless CMS Site', desc: 'Headless WordPress + Astro frontend with REST API data fetching and ISR-style static pages.', tags: ['Astro', 'WordPress', 'REST API'], category: 'astro', url: '#' },
];

const categories = ['all', ...new Set(projects.map(p => p.category))];
---
<BaseLayout title="Portfolio" description="Web development projects – WordPress, Astro, DevOps">
<section class="page-hero">
  <div class="container">
    <span class="tag tag-purple" style="display:inline-block;margin-bottom:1rem">Portfolio</span>
    <h1>Projects</h1>
    <p class="lead">{projects.length} projects across WordPress, Astro and DevOps.</p>
  </div>
</section>
<section class="portfolio-section">
  <div class="container">
    <div class="filter-bar" id="filterBar">
      {categories.map(c => (
        <button class={`filter-btn${c === 'all' ? ' active' : ''}`} data-filter={c}>{c}</button>
      ))}
    </div>
    <div class="projects-grid" id="projectsGrid">
      {projects.map(p => (
        <div class="project-card" data-category={p.category}>
          <h2 class="project-title">{p.title}</h2>
          <p class="project-desc">{p.desc}</p>
          <div class="project-tags">
            {p.tags.map(t => <span class="tag tag-purple">{t}</span>)}
          </div>
          <a href={p.url} class="project-link btn btn-outline">View Project →</a>
        </div>
      ))}
    </div>
  </div>
</section>
</BaseLayout>
<style>
.page-hero { padding: clamp(3rem,6vw,5rem) 0 2rem; }
.page-hero h1 { font-size: clamp(2rem,4vw,3.2rem); font-weight:800; margin-bottom:.75rem; }
.lead { color:var(--color-text-muted); font-size:1.1rem; }
.portfolio-section { padding: 1rem 0 5rem; }
.filter-bar { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:2rem; }
.filter-btn {
  padding:.4rem 1rem; border-radius:var(--radius-full);
  background:var(--color-surface); border:1px solid var(--color-border);
  color:var(--color-text-muted); font-size:.85rem; font-weight:500; cursor:pointer;
  transition:all var(--transition); text-transform:capitalize;
}
.filter-btn:hover, .filter-btn.active { background:var(--color-primary); border-color:var(--color-primary); color:#fff; }
.projects-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr)); gap:1.25rem; }
.project-card {
  display:flex; flex-direction:column; gap:.75rem;
  padding:1.5rem; background:var(--color-surface); border:1px solid var(--color-border);
  border-radius:var(--radius-lg); transition:all var(--transition);
}
.project-card:hover { border-color:var(--color-primary); transform:translateY(-3px); box-shadow:var(--shadow-card); }
.project-card.hidden { display:none; }
.project-title { font-family:var(--font-display); font-size:1.15rem; font-weight:700; }
.project-desc { color:var(--color-text-muted); font-size:.9rem; line-height:1.6; flex:1; }
.project-tags { display:flex; flex-wrap:wrap; gap:.4rem; }
.project-link { margin-top:.5rem; align-self:flex-start; font-size:.82rem; padding:.45rem 1rem; }
</style>
<script>
const btns = document.querySelectorAll('.filter-btn');
const cards = document.querySelectorAll('.project-card');
btns.forEach(btn => {
  btn.addEventListener('click', () => {
    btns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    cards.forEach(card => {
      if (filter === 'all' || card.dataset.category === filter) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });
});
</script>
