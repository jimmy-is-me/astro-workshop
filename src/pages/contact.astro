---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch – contact form">
<section class="page-hero">
  <div class="container">
    <span class="tag tag-teal" style="display:inline-block;margin-bottom:1rem">Contact</span>
    <h1>Get In Touch</h1>
    <p class="lead">Have a project in mind? Let's talk.</p>
  </div>
</section>
<section class="contact-section">
  <div class="container contact-grid">
    <div class="contact-info">
      <h2>Let's work together</h2>
      <p>I'm available for freelance WordPress and Astro projects. Reach out and I'll get back to you within 24 hours.</p>
      <div class="info-list">
        <div class="info-item"><span class="info-icon">📍</span><span>Kaohsiung, Taiwan</span></div>
        <div class="info-item"><span class="info-icon">⚡</span><span>WordPress · Astro · WooCommerce</span></div>
        <div class="info-item"><span class="info-icon">🌐</span><a href="https://github.com/jimmy-is-me" target="_blank" rel="noopener" style="color:var(--color-primary-light)">github.com/jimmy-is-me</a></div>
      </div>
    </div>
    <form name="contact" method="POST" data-netlify="true" class="contact-form" id="contactForm">
      <input type="hidden" name="form-name" value="contact" />
      <div class="form-group">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" placeholder="Your name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" required />
      </div>
      <div class="form-group">
        <label for="subject">Subject</label>
        <input id="subject" name="subject" type="text" placeholder="Project inquiry" />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" placeholder="Tell me about your project..." required></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Message →</button>
      <p class="form-note">This form works with Cloudflare Pages or Netlify Forms. No server required.</p>
    </form>
  </div>
</section>
</BaseLayout>
<style>
.page-hero { padding: clamp(3rem,6vw,5rem) 0 2rem; }
.page-hero h1 { font-size: clamp(2rem,4vw,3.2rem); font-weight:800; margin-bottom:.75rem; }
.lead { color:var(--color-text-muted); font-size:1.1rem; }
.contact-section { padding: 2rem 0 5rem; }
.contact-grid { display:grid; grid-template-columns:1fr 1.2fr; gap:4rem; align-items:start; }
.contact-info h2 { font-size:1.4rem; font-weight:700; margin-bottom:.75rem; }
.contact-info p { color:var(--color-text-muted); margin-bottom:1.5rem; max-width:40ch; }
.info-list { display:flex; flex-direction:column; gap:.75rem; }
.info-item { display:flex; align-items:center; gap:.75rem; color:var(--color-text-muted); font-size:.9rem; }
.info-icon { font-size:1.1rem; }
.contact-form { display:flex; flex-direction:column; gap:1.25rem; background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); padding:2rem; }
.form-group { display:flex; flex-direction:column; gap:.4rem; }
.form-group label { font-size:.85rem; font-weight:600; color:var(--color-text-muted); }
.form-group input, .form-group textarea {
  padding:.7rem 1rem; background:var(--color-bg); border:1px solid var(--color-border);
  border-radius:var(--radius-md); color:var(--color-text); font-size:.95rem; font-family:var(--font-body);
  transition:border-color var(--transition);
}
.form-group input:focus, .form-group textarea:focus { outline:none; border-color:var(--color-primary); }
.form-group textarea { resize:vertical; line-height:1.6; }
.form-note { font-size:.8rem; color:var(--color-text-muted); text-align:center; margin-top:-.5rem; }
@media(max-width:700px){.contact-grid{grid-template-columns:1fr;}}
</style>
