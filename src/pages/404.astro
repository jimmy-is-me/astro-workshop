---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 – Page Not Found">
<div class="container" style="padding:8rem 0;text-align:center">
  <div style="font-size:6rem;margin-bottom:1rem">🚀</div>
  <h1 style="font-size:clamp(2rem,5vw,4rem);font-weight:800;margin-bottom:1rem"><span class="gradient-text">404</span></h1>
  <p style="color:var(--color-text-muted);font-size:1.1rem;margin-bottom:2rem;max-width:40ch;margin-inline:auto">This page drifted off into space. Let's get you back on track.</p>
  <a href="/" class="btn btn-primary">Back to Home &rarr;</a>
</div>
</BaseLayout>
